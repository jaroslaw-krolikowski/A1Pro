{
  "exceptions": {
    "command_timeout": "The lock did not take the command within {seconds} s. The command was dropped and will not run later. Check the lock on site.",
    "command_pending": "The previous command ({command}) is still on its way to the lock. Wait for it to finish.",
    "command_replaced": "Dropped: a lock command was sent before this one reached the lock.",
    "calibration_cooldown": "Calibration was started less than 2 minutes ago. Try again in {seconds} s.",
    "calibration_unsupported": "This lock has no calibration."
  },
  "config": {
    "abort": {
      "no_unconfigured_devices": "No unconfigured devices found."
    },
    "error": {
      "device_not_registered": "Device is not registered, please check config."
    },
    "flow_title": "{name}",
    "step": {
      "device": {
        "data": {
          "address": "Tuya BLE device"
        },
        "description": "Select Tuya BLE device to setup. Device must be registered in the cloud using the mobile application. It's better to unbind the device from Tuya Bluetooth gateway, if any."
      }
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Tuya BLE options",
        "description": "How Home Assistant talks to a battery lock that sleeps between commands (Raykube A1 Ultra). Other devices ignore this setting.",
        "data": {
          "connection_mode": "Connection mode"
        },
        "data_description": {
          "connection_mode": "Arming-mode notifications need HA to learn about a manual turn quickly: choose \"Permanent connection\", or \"On advertisement change\" if the lock signals changes in its advertisements (see the Connection sensor). The Tuya app cannot connect while HA holds the connection."
        }
      }
    }
  },
  "selector": {
    "connection_mode": {
      "options": {
        "periodic": "Read every 5 minutes (default): HA connects and reads the state at most every 5 minutes; a manual turn shows up up to 5 minutes late",
        "advertisement_change": "On advertisement change (experimental): HA reads the state as soon as the lock changes what it broadcasts, plus every 30 minutes; fastest with the least battery use, if the lock signals changes",
        "permanent": "Permanent connection (24/7): HA keeps the connection open and reconnects within a minute; changes arrive in seconds, uses the most battery"
      }
    }
  },
